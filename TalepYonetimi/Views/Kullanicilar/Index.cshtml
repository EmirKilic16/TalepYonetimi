@model IReadOnlyList<TalepYonetimi.Application.DTOs.Kullanicilar.KullaniciListeDto>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Kullanıcılar</h1>
        <p class="text-muted mb-0">Sistemdeki kullanıcı hesaplarını yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni kullanıcı</a>
</div>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body py-5 text-center">
            <h2 class="h5">Henüz kullanıcı bulunmuyor</h2>
            <p class="text-muted">İlk kullanıcı hesabını oluşturarak başlayabilirsiniz.</p>
            <a asp-action="Create" class="btn btn-primary">Kullanıcı oluştur</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="myTable">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Oluşturma Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kullanici in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@kullanici.AdSoyad</td>
                            <td>@kullanici.Eposta</td>
                            <td>@kullanici.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@kullanici.Id"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="Delete"
                                      asp-route-id="@kullanici.Id"
                                      method="post"
                                      class="d-inline"
                                      data-confirm-delete="@kullanici.AdSoyad">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-confirm-delete]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                const name = form.getAttribute('data-confirm-delete');
                if (!window.confirm(name + ' adlı kullanıcıyı silmek istediğinize emin misiniz?')) {
                    event.preventDefault();
                }
            });
        });
        let table = new DataTable('#myTable');
    </script>
}
