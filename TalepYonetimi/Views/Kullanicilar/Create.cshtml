@model TalepYonetimi.Application.DTOs.Kullanicilar.KullaniciOlusturDto

@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none">&larr; Kullanıcılara dön</a>
            <h1 class="h3 mt-3 mb-1">Yeni kullanıcı</h1>
            <p class="text-muted">Yeni kullanıcı hesabının bilgilerini girin.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Ad" class="form-label"></label>
                            <input asp-for="Ad" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Soyad" class="form-label"></label>
                            <input asp-for="Soyad" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Eposta" class="form-label"></label>
                            <input asp-for="Eposta" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Eposta" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Sifre" class="form-label"></label>
                            <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Sifre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SifreTekrar" class="form-label"></label>
                            <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="SifreTekrar" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">Kullanıcı oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
