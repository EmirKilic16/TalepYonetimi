@model TalepYonetimi.Application.DTOs.Talepler.TalepOlusturDto
@{
    ViewData["Title"] = "Yeni Talep";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none">&larr; Taleplere dön</a>
            <h1 class="h3 mt-3 mb-1">Yeni talep</h1>
            <p class="text-muted">Talep bilgilerini girin.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Baslik" class="form-label"></label>
                            <input asp-for="Baslik" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Baslik" class="text-danger"></span>
                        </div>
                       
                       
                    </div>
                    <div class="row g-1">
                        <div class="col-md-12">
                            <label asp-for="Aciklama" class="form-label"></label>
                            <input asp-for="Aciklama" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Aciklama" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">Talep oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>